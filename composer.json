{
  "name": "dafap/dafap-seo",
  "description": "Plugin WordPress pour évaluer le score SEO des articles",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": "^8.1",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "DafapSEO\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DafapSEO\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
